<Window x:Class="Aura3DRobotConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hkt="http://helix-toolkit.org/wpf"
        xmlns:hx="clr-namespace:HelixToolkit.Wpf.SharpDX;assembly=HelixToolkit.Wpf.SharpDX"
        xmlns:local="clr-namespace:Aura3DRobotConverter"
        mc:Ignorable="d"
        Title="Aura3D AI Robot CAD Converter (STEP -> URDF/USD)" 
        Height="768" Width="1200"
        Background="#F3F3F3"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: Robot Editor (Windows 11 Fluent Light Sidebar) -->
        <Border Grid.Column="0" Background="#EAEAEA" BorderBrush="#D5D5D5" BorderThickness="0,0,1,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="Auto" /> <!-- Upload button -->
                    <RowDefinition Height="*" />    <!-- TreeView -->
                    <RowDefinition Height="Auto" /> <!-- Param Editor -->
                    <RowDefinition Height="Auto" /> <!-- Export Button -->
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="AURA3D ROBOT CONVERTER" Foreground="#0067C0" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Local .NET Desktop Kinematics Compiler" Foreground="#5F5F5F" FontSize="11" Margin="0,2,0,0" />
                    
                    <!-- Loaded File Name Display -->
                    <Border x:Name="LoadedFileBorder" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 파일: " Foreground="#5F5F5F" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LoadedFileNameTextBlock" Text="" Foreground="#1C1C1C" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" Width="260"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step Load & Import Buttons -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <!-- CAD Up Axis Setting -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CAD 높이축 (Up Axis)" Foreground="#5F5F5F" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UpAxisComboBox" Grid.Column="1" SelectedIndex="1" Width="110" Height="24" FontSize="11" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC">
                            <ComboBoxItem Content="Y-Up"/>
                            <ComboBoxItem Content="Z-Up (기본)"/>
                        </ComboBox>
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="STEP 파일 변환..." Click="OnOpenStepFileClick" Height="36" Background="#FFFFFF" Foreground="#0067C0" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="1" Content="사양서 가져오기..." Click="OnImportModelClick" Height="36" Background="#FFFFFF" Foreground="#0067C0" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand" Margin="4,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <Button Content="새 파일 (초기화)" Click="OnNewFileClick" Height="34" Background="#FFFFFF" Foreground="#D83B01" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand" Margin="0,8,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Assembly Tree View -->
                <GroupBox Grid.Row="2" Header="로봇 링크 및 관절 계층" Foreground="#0067C0" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,15" Padding="5">
                    <TreeView x:Name="RobotTreeView" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Foreground="#1C1C1C" SelectedItemChanged="OnRobotTreeViewSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <EventSetter Event="Selected" Handler="OnTreeViewItemSelected" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="불투명 (Opaque)" Click="OnSetOpaqueClick" Tag="{Binding}" />
                                            <MenuItem Header="반투명 (Semi-Transparent)" Click="OnSetSemiTransparentClick" Tag="{Binding}" />
                                            <MenuItem Header="투명 (Transparent / Hidden)" Click="OnSetTransparentClick" Tag="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="모든 하위 파트 불투명 (All Sub-parts Opaque)" Click="OnSetAllOpaqueClick" Tag="{Binding}" />
                                            <MenuItem Header="모든 하위 파트 반투명 (All Sub-parts Semi-Transparent)" Click="OnSetAllSemiTransparentClick" Tag="{Binding}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding Name}" Foreground="#1C1C1C" FontSize="12" Margin="2" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </GroupBox>

                <!-- Joint Config Editor Panel (Initially Hidden/Collapsed) -->
                <Border x:Name="JointEditorPanel" Grid.Row="3" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="JointEditorTitle" Text="관절 매개변수 설정" Foreground="#0067C0" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                        <!-- Joint Type Selection -->
                        <TextBlock Text="관절 형태 (Type):" Foreground="#5F5F5F" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox x:Name="JointTypeComboBox" SelectionChanged="OnJointTypeChanged" Height="28" Margin="0,0,0,10" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="Foreground" Value="#1C1C1C" />
                                    <Setter Property="Padding" Value="6,4,6,4" />
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="revolute (회전)" />
                            <ComboBoxItem Content="continuous (무한회전)" />
                            <ComboBoxItem Content="prismatic (이동)" />
                            <ComboBoxItem Content="fixed (고정)" />
                        </ComboBox>

                        <!-- Rotation/Prismatic Axis XYZ -->
                        <TextBlock Text="회전/이동축 (Axis XYZ):" Foreground="#5F5F5F" FontSize="11" Margin="0,0,0,3" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="X" Foreground="#CC2222" FontSize="9.5" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="AxisXTextBox" TextChanged="OnAxisChanged" Height="24" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                <TextBlock Text="Y" Foreground="#228822" FontSize="9.5" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="AxisYTextBox" TextChanged="OnAxisChanged" Height="24" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Z" Foreground="#2222CC" FontSize="9.5" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="AxisZTextBox" TextChanged="OnAxisChanged" Height="24" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Angle Limits Lower/Upper (Not applicable for Fixed/Continuous) -->
                        <Grid x:Name="LimitsGrid" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="최소각 (Lower Limit, Rad):" Foreground="#5F5F5F" FontSize="11" Margin="0,0,0,3" />
                                <TextBox x:Name="LimitLowerTextBox" TextChanged="OnLimitChanged" Height="26" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="최대각 (Upper Limit, Rad):" Foreground="#5F5F5F" FontSize="11" Margin="0,0,0,3" />
                                <TextBox x:Name="LimitUpperTextBox" TextChanged="OnLimitChanged" Height="26" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Build Package button -->
                <Button Grid.Row="4" Content="URDF &amp; USD 패키지 생성 및 저장..." Click="OnExportRobotClick" Height="40" Background="#0067C0" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- RIGHT AREA: Viewport + Log Console -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Background="#ECECEC" BorderThickness="0">
                <TabItem Header="3D 뷰">
                    <Grid>
                        <hx:Viewport3DX x:Name="Viewport" Background="#ECECEC" BorderBrush="#D5D5D5" BorderThickness="0,0,0,1"
                                         ShowCoordinateSystem="True" ModelUpDirection="0,0,1" MouseDown="OnViewportMouseDown"
                                         RotateCursor="SizeAll" PanCursor="Hand" ZoomCursor="SizeNS">
                            <hx:Viewport3DX.Camera>
                                <hx:PerspectiveCamera Position="3, -3, 2" LookDirection="-3, 3, -2" UpDirection="0, 0, 1" />
                            </hx:Viewport3DX.Camera>
                        </hx:Viewport3DX>

                        <!-- FLOATING TOOLBAR: Camera Controls -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Background="#E0F3F3F3" BorderBrush="#D5D5D5" BorderThickness="1" CornerRadius="6" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.1" ShadowDepth="1" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <!-- Zoom Controls -->
                                <Button ToolTip="줌 인" Click="OnZoomInClick" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <TextBlock Text="➕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button ToolTip="줌 아웃" Click="OnZoomOutClick" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <TextBlock Text="➖" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Separator Width="1" Height="20" Background="#CCCCCC" Margin="4,0,4,0"/>
                                <!-- Preset Views -->
                                <Button Content="ISO" ToolTip="입체 뷰 (Home)" Click="OnIsoViewClick" Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#1C1C1C" FontSize="10.5" FontWeight="SemiBold"/>
                                <Button Content="TOP" ToolTip="윗면 뷰 (T)" Click="OnTopViewClick" Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#1C1C1C" FontSize="10.5" FontWeight="SemiBold"/>
                                <Button Content="FRNT" ToolTip="앞면 뷰" Click="OnFrontViewClick" Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#1C1C1C" FontSize="10.5" FontWeight="SemiBold"/>
                                <Button Content="LEFT" ToolTip="좌면 뷰" Click="OnLeftViewClick" Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#1C1C1C" FontSize="10.5" FontWeight="SemiBold"/>
                                <Button Content="RGHT" ToolTip="우면 뷰" Click="OnRightViewClick" Width="32" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#1C1C1C" FontSize="10.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="텍스트 뷰">
                    <Grid Background="#FFFFFF">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Text Editor Toolbar -->
                        <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#D5D5D5" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="적용 및 3D 갱신" Click="OnApplyTextChangesClick" Padding="12,6" Background="#0067C0" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Text="* 텍스트 뷰에서 XML/URDF를 수정하고 적용하면 3D 모델이 업데이트됩니다." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#666666" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <!-- XML Text Editor -->
                        <TextBox x:Name="XmlTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12.5" Padding="10" BorderThickness="0" Background="#FFFFFF" Foreground="#1C1C1C" />
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Log Console Output -->
            <Grid Grid.Row="1" Background="#EAEAEA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="실시간 변환 콘솔 로그" Foreground="#5F5F5F" FontSize="11" FontWeight="SemiBold" Margin="12,10,12,4" />
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" Background="#FFFFFF" Foreground="#1C1C1C" BorderThickness="1" BorderBrush="#CCCCCC" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Margin="12,0,12,12" />
            </Grid>
        </Grid>
    </Grid>
</Window>
